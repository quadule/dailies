{
  "name": "dailies-runtime",
  "version": "0.6.0",
  "private": true,
  "description": "Shared runtime layout, installation and artifact discovery for the Dailies CLI and daemon.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./artifacts": {
      "types": "./src/artifacts.ts",
      "source": "./src/artifacts.ts",
      "default": "./src/artifacts.ts"
    },
    "./paths": {
      "types": "./src/paths.ts",
      "source": "./src/paths.ts",
      "default": "./src/paths.ts"
    },
    "./install": {
      "types": "./src/install.ts",
      "source": "./src/install.ts",
      "default": "./src/install.ts"
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dailies-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dailies-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
