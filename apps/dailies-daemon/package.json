{
  "name": "dailies-daemon",
  "version": "0.6.0",
  "private": true,
  "description": "Dailies daemon \u2014 long-running Playwright host with QuickJS sandbox. Embedded into the dailies CLI at build time.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm bundle && pnpm bundle:sandbox-client",
    "bundle": "esbuild src/daemon.ts --bundle --platform=node --format=esm --outfile=dist/daemon.bundle.mjs --external:playwright --external:quickjs-emscripten --external:@jitl/* --external:pino",
    "bundle:sandbox-client": "tsx scripts/bundle-sandbox-client.ts",
    "clean": "rm -rf dist coverage .turbo",
    "compile": "tsc --noEmit",
    "dev": "tsx src/daemon.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dailies-logger": "workspace:*",
    "dailies-protocol": "workspace:*",
    "dailies-runtime": "workspace:*",
    "pino": "^10.3.1",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dailies-config": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
