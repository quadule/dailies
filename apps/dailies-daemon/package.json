{
  "name": "dailies-daemon",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Dailies daemon — long-running Playwright host with QuickJS sandbox. Embedded into the dailies CLI at build time.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm bundle && pnpm bundle:sandbox-client",
    "bundle": "esbuild src/daemon.ts --bundle --platform=node --format=esm --outfile=dist/daemon.bundle.mjs --external:playwright --external:quickjs-emscripten --external:@jitl/* --external:pino",
    "bundle:sandbox-client": "tsx scripts/bundle-sandbox-client.ts",
    "dev": "tsx src/daemon.ts",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "dailies-logger": "workspace:*",
    "dailies-protocol": "workspace:*",
    "pino": "^9.5.0",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "quickjs-emscripten": "^0.32.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "dailies-config": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
