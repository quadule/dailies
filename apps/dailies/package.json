{
  "name": "dailies-cli",
  "version": "0.5.0",
  "type": "module",
  "description": "Dailies CLI. Records a browser session as ordered steps — trace, video, HAR, console — renders a self-contained report, and can cut the recording into a narrated demo film.",
  "license": "MIT",
  "keywords": [
    "dailies",
    "demo-video",
    "screencast",
    "browser-automation",
    "qa",
    "playwright",
    "testing",
    "pull-request",
    "ai-agent"
  ],
  "homepage": "https://github.com/quadule/dailies#readme",
  "bugs": "https://github.com/quadule/dailies/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quadule/dailies.git",
    "directory": "apps/dailies"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dailies": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.ts",
    "compile": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "clean": "rm -rf dist coverage .turbo",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "dailies-cli-kit": "workspace:*",
    "dailies-config": "workspace:*",
    "dailies-daemon-client": "workspace:*",
    "dailies-logger": "workspace:*",
    "dailies-protocol": "workspace:*",
    "@types/node": "^20.17.10",
    "commander": "^12.1.0",
    "esbuild": "^0.27.4",
    "fflate": "^0.8.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
