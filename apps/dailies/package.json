{
  "name": "dailies-cli",
  "version": "0.6.0",
  "description": "Dailies CLI. Records a browser session as ordered steps \u2014 trace, video, HAR, console \u2014 renders a self-contained report, and can cut the recording into a narrated demo film.",
  "keywords": [
    "dailies",
    "demo-video",
    "screencast",
    "browser-automation",
    "qa",
    "playwright",
    "testing",
    "pull-request",
    "ai-agent"
  ],
  "homepage": "https://github.com/quadule/dailies#readme",
  "bugs": "https://github.com/quadule/dailies/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quadule/dailies.git",
    "directory": "apps/dailies"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "dailies": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist coverage .turbo",
    "compile": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "prepack": "node scripts/build.mjs",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "commander": "^15.0.0",
    "dailies-cli-kit": "workspace:*",
    "dailies-config": "workspace:*",
    "dailies-daemon-client": "workspace:*",
    "dailies-logger": "workspace:*",
    "dailies-protocol": "workspace:*",
    "dailies-runtime": "workspace:*",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
